// Converted from: girepository/cmph/meson.build - cmph static library
cc_library_static {
    name: "libgirepository_cmph",
    defaults: ["glib_defaults"],
    vendor_available: true,
    srcs: [
        // Converted from: cmph_sources
        "cmph/bdz.c",
        "cmph/bdz_ph.c",
        "cmph/bmz8.c",
        "cmph/bmz.c",
        "cmph/brz.c",
        "cmph/buffer_entry.c",
        "cmph/buffer_manager.c",
        "cmph/chd.c",
        "cmph/chd_ph.c",
        "cmph/chm.c",
        "cmph/cmph.c",
        "cmph/cmph_structs.c",
        "cmph/compressed_rank.c",
        "cmph/compressed_seq.c",
        "cmph/fch_buckets.c",
        "cmph/fch.c",
        "cmph/graph.c",
        "cmph/hash.c",
        "cmph/jenkins_hash.c",
        "cmph/miller_rabin.c",
        "cmph/select.c",
        "cmph/vqueue.c",
        "cmph/vstack.c",
    ],
    // Converted from: custom_c_args (warning suppressions)
    cflags: [
        "-Wno-implicit-fallthrough",
        "-Wno-old-style-definition",
        "-Wno-suggest-attribute=noreturn",
        "-Wno-type-limits",
        "-Wno-undef",
        "-Wno-unused-parameter",
        "-Wno-cast-align",
        "-Wno-unused-function",
        "-Wno-return-type",
        "-Wno-sometimes-uninitialized",
    ],
    shared_libs: [
        "libglib-2.0",
        "libgobject-2.0",
    ],
    // Converted from: include_directories: include_directories('.')
    export_include_dirs: [
        "cmph",
    ],
}

