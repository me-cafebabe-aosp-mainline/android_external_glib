// Converted from: gio/meson.build
// GIO library - Android.bp build rules

// Converted from: gio/xdgmime/meson.build - xdgmime_lib static library
cc_library_static {
    name: "libgio_xdgmime",
    defaults: ["glib_defaults"],
    vendor_available: true,
    srcs: [
        "xdgmime/xdgmime.c",
        "xdgmime/xdgmimealias.c",
        "xdgmime/xdgmimecache.c",
        "xdgmime/xdgmimeglob.c",
        "xdgmime/xdgmimeicon.c",
        "xdgmime/xdgmimeint.c",
        "xdgmime/xdgmimemagic.c",
        "xdgmime/xdgmimeparent.c",
    ],
    // Converted from: c_args: ['-DHAVE_CONFIG_H', '-DXDG_PREFIX=_gio_xdg', extra_xdgmime_args]
    cflags: [
        "-DHAVE_CONFIG_H",
        "-DXDG_PREFIX=_gio_xdg",
        "-Wno-sign-conversion",
    ],
}

// Converted from: gio/inotify/meson.build - inotify_lib static library
cc_library_static {
    name: "libgio_inotify",
    defaults: ["glib_defaults"],
    vendor_available: true,
    srcs: [
        // Converted from: inotify_sources
        "inotify/inotify-kernel.c",
        "inotify/inotify-sub.c",
        "inotify/inotify-path.c",
        "inotify/inotify-missing.c",
        "inotify/inotify-helper.c",
        "inotify/ginotifyfilemonitor.c",
    ],
    // Converted from: c_args: [gio_c_args, gio_c_args_internal]
    cflags: [
        "-DG_LOG_DOMAIN=\"GLib-GIO\"",
        "-DGIO_COMPILATION",
        "-DGIO_LAUNCH_DESKTOP=\"/system/bin/gio-launch-desktop\"",
        "-DGIO_MODULE_DIR=\"/system/lib/gio/modules\"",
        "-DLOCALSTATEDIR=\"/data/local/tmp/var\"",
    ],
    shared_libs: [
        "libglib-2.0",
        "libgobject-2.0",
    ],
}

